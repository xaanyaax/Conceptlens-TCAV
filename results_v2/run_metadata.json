{
  "model": "torchvision GoogLeNet, ImageNet weights, frozen",
  "activations": "flattened c*h*w (no pooling)",
  "gradient_of": "zebra logit",
  "layers": [
    "inception4d"
  ],
  "cav_methods": [
    "sgd"
  ],
  "sgd_alpha": 0.01,
  "val_fraction": 0.3333333333333333,
  "num_runs": 500,
  "n_concept_images": 50,
  "target_splits": [
    "training",
    "val",
    "test"
  ],
  "n_hypothesis_tests_for_bonferroni": 1,
  "frozen_detection": {
    "num_images": 583,
    "accuracy": 0.9691252144082333,
    "precision": 0.9923273657289002,
    "recall": 0.9627791563275434,
    "f1": 0.9773299748110831,
    "confusion_matrix": [
      [
        177,
        3
      ],
      [
        15,
        388
      ]
    ],
    "rule": "predicted zebra if GoogLeNet top-1 ImageNet class is 'zebra'"
  },
  "notes": [
    "CAV val accuracy is NOT zebra classification accuracy.",
    "Runs share the same target + concept images: the t-tests are about variability over counterexample draws, not independent studies.",
    "ci95_boot_images_* resamples target images (image-sampling uncertainty)."
  ]
